# Hostinger FTP Deployment Credentials
# Copy this file to `.env.local` and enter your actual FTP password/username!

FTP_HOST=ftp.pikadon.ug
FTP_USER=your_hostinger_ftp_username
FTP_PASSWORD=your_hostinger_ftp_password
FTP_PORT=21
FTP_REMOTE_ROOT=public_html

# Pikadon OS (pikadon.ug/app). Leave empty to run the app in demo mode.
# Use the "anon public" key only — never the service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
